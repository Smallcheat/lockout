            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Members",
          "type": "array"
        },
        "min_available": {
          "default": 1,
          "minimum": 1,
          "title": "Min Available",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "members"
      ],
      "title": "RedundancyGroup",
      "type": "object"
