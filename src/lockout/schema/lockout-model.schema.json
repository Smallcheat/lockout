        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EdgeType": {
      "description": "The four dependency types. ADR-0001 keeps this set closed.",
      "enum": [
        "requires_to_start",
        "requires_to_authenticate",
        "requires_to_reach",
        "requires_to_authorize"
      ],
      "title": "EdgeType",
      "type": "string"
